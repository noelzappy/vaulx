package templates

import "github.com/noelzappy/vaulx/internal/viewmodel"

templ SharedFolderPage(slug, folderName string, isRoot bool, folders []viewmodel.FolderView, files []viewmodel.FileView) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ folderName } — Vaulx</title>
			<link rel="stylesheet" href="/static/app.css"/>
		</head>
		<body>
			<div class="shared-page">
				<header class="shared-header">
					<div class="sidebar-logo" style="padding:0;">Vaul<span>x</span></div>
					<div>
						<h1 class="shared-title">{ folderName }</h1>
						<p class="shared-subtitle">Shared folder — read only</p>
					</div>
				</header>
				<main class="shared-main">
					if !isRoot {
						<a class="btn btn-ghost" style="margin-bottom:16px;" href={ templ.SafeURL("/s/" + slug) }>← Back to shared folder</a>
					}
					if len(folders) == 0 && len(files) == 0 {
						<div class="empty-state" style="padding:60px 20px;text-align:center;">
							<p style="font-size:14px;color:var(--text-muted);">This folder is empty.</p>
						</div>
					}
					if len(folders) > 0 {
						<p class="section-heading">Folders</p>
						<div class="file-grid">
							for _, f := range folders {
								<a class="card" style="display:block;" href={ templ.SafeURL("/s/" + slug + "?folder=" + f.ID) }>
									<div class="card-icon card-folder-icon">
										<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-8.69-6.44-2.12-2.12a1.5 1.5 0 0 0-1.061-.44H4.5A2.25 2.25 0 0 0 2.25 6v12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9a2.25 2.25 0 0 0-2.25-2.25h-5.379a1.5 1.5 0 0 1-1.06-.44Z"></path>
										</svg>
									</div>
									<div class="card-name">{ f.Name }</div>
								</a>
							}
						</div>
					}
					if len(files) > 0 {
						<p class="section-heading">Files</p>
						<div class="file-grid">
							for _, f := range files {
								<a class="card" style="display:block;" href={ templ.SafeURL("/s/" + slug + "/file/" + f.ID) } title={ "Download " + f.Name }>
									<div class="card-icon">
										@fileTypeIcon(f.MimeType)
									</div>
									<div class="card-name">{ f.Name }</div>
									<div class="card-meta">
										<span>{ f.SizeHuman }</span>
										<span class="card-meta-sep">·</span>
										<span>Download</span>
									</div>
								</a>
							}
						</div>
					}
				</main>
			</div>
		</body>
	</html>
}

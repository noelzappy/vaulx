package templates

import (
	"fmt"
	"github.com/noelzappy/vaulx/internal/viewmodel"
)

templ FilesPage(data viewmodel.FileBrowserData, user viewmodel.UserView) {
	@Layout("My Files", user, true) {
		@FileBrowserContent(data, user)
	}
}

templ FileBrowserContent(data viewmodel.FileBrowserData, user viewmodel.UserView) {
	<div id="browser-content">
		<div class="toolbar">
			<div>
				@Breadcrumb(data.Breadcrumbs)
			</div>
			<div style="display:flex;gap:8px;align-items:center;">
				@searchBox("")
				if user.Role == "admin" || user.Role == "editor" {
					<button
						class="btn btn-ghost"
						onclick="document.getElementById('new-folder-form').style.display='flex'"
					>
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width:14px;height:14px">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
						</svg>
						New Folder
					</button>
				}
			</div>
		</div>
		if user.Role == "admin" || user.Role == "editor" {
			<div id="uppy-container" data-folder-id={ data.FolderID } style="margin-bottom:20px;"></div>
		}
		<form
			id="new-folder-form"
			style="display:none;gap:8px;margin-bottom:20px;align-items:center"
			hx-post="/files/folders"
			hx-target="#browser-content"
			hx-swap="outerHTML"
		>
			if data.FolderID != "" {
				<input type="hidden" name="parent_id" value={ data.FolderID }/>
			}
			<input class="input" style="max-width:280px" name="name" placeholder="Folder name" required autofocus/>
			<button class="btn btn-primary" type="submit">Create</button>
			<button class="btn btn-ghost" type="button" onclick="document.getElementById('new-folder-form').style.display='none'">Cancel</button>
		</form>
		if len(data.Folders) == 0 && len(data.Files) == 0 {
			<div class="empty-state" style="padding:60px 20px;text-align:center;">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" style="width:40px;height:40px;opacity:.3;margin-bottom:12px;">
					<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-8.69-6.44-2.12-2.12a1.5 1.5 0 0 0-1.061-.44H4.5A2.25 2.25 0 0 0 2.25 6v12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9a2.25 2.25 0 0 0-2.25-2.25h-5.379a1.5 1.5 0 0 1-1.06-.44Z"></path>
				</svg>
				<p style="font-size:14px;font-weight:500;color:var(--text);margin-bottom:6px;">This folder is empty</p>
				if user.Role == "admin" || user.Role == "editor" {
					<p style="font-size:12.5px;color:var(--text-muted);">Drop files in the uploader above, or create a folder.</p>
				}
			</div>
		} else {
			if len(data.Folders) > 0 {
				<p class="section-heading">Folders</p>
				<div class="file-grid">
					for _, folder := range data.Folders {
						@FolderCard(folder)
					}
				</div>
			}
			if len(data.Files) > 0 {
				<p class="section-heading">Files</p>
				<div class="file-grid">
					for _, file := range data.Files {
						@FileCard(file,
							user.Role == "admin" || (user.Role == "editor" && file.UploaderID == user.ID),
							user.Role == "admin",
						)
					}
				</div>
			}
		}
		if data.Pagination != nil {
			@PaginationBar(*data.Pagination, currentBrowserURL(data))
		}
	</div>
}

templ Breadcrumb(crumbs []viewmodel.BreadcrumbItem) {
	<nav class="breadcrumb">
		for i, crumb := range crumbs {
			if i == len(crumbs)-1 {
				<span class="breadcrumb-current">{ crumb.Name }</span>
			} else {
				<a
					href={ templ.SafeURL(crumb.URL) }
					hx-get={ crumb.URL }
					hx-target="#browser-content"
					hx-swap="outerHTML"
					hx-push-url={ crumb.URL }
				>{ crumb.Name }</a>
				<span class="breadcrumb-sep">/</span>
			}
		}
	</nav>
}

templ PaginationBar(p viewmodel.PaginationData, baseURL string) {
	<div class="pagination-bar">
		if p.Page > 1 {
			<a
				class="btn btn-ghost"
				href={ templ.SafeURL(fmt.Sprintf("%s?page=%d&limit=%d", baseURL, p.Page-1, p.Limit)) }
				hx-get={ fmt.Sprintf("%s?page=%d&limit=%d", baseURL, p.Page-1, p.Limit) }
				hx-target="#browser-content"
				hx-swap="outerHTML"
				hx-push-url="true"
			>Previous</a>
		} else {
			<span class="btn btn-ghost" style="opacity:.35;cursor:default;">Previous</span>
		}
		<span class="pagination-info">Page { fmt.Sprintf("%d", p.Page) } of { fmt.Sprintf("%d", p.TotalPages) }</span>
		if p.Page < p.TotalPages {
			<a
				class="btn btn-ghost"
				href={ templ.SafeURL(fmt.Sprintf("%s?page=%d&limit=%d", baseURL, p.Page+1, p.Limit)) }
				hx-get={ fmt.Sprintf("%s?page=%d&limit=%d", baseURL, p.Page+1, p.Limit) }
				hx-target="#browser-content"
				hx-swap="outerHTML"
				hx-push-url="true"
			>Next</a>
		} else {
			<span class="btn btn-ghost" style="opacity:.35;cursor:default;">Next</span>
		}
	</div>
}

func currentBrowserURL(data viewmodel.FileBrowserData) string {
	if data.FolderID != "" {
		return "/files/" + data.FolderID
	}
	return "/files"
}

templ searchBox(q string) {
	<input
		class="input search-box"
		type="search"
		name="q"
		placeholder="Search files…"
		value={ q }
		hx-get="/files/search"
		hx-trigger="input changed delay:300ms, search"
		hx-target="#browser-content"
		hx-swap="outerHTML"
		hx-push-url="true"
	/>
}

templ SearchPage(q string, folders []viewmodel.FolderView, files []viewmodel.FileView, user viewmodel.UserView) {
	@Layout("Search", user, false) {
		@SearchResults(q, folders, files, user)
	}
}

templ SearchResults(q string, folders []viewmodel.FolderView, files []viewmodel.FileView, user viewmodel.UserView) {
	<div id="browser-content">
		<div class="toolbar">
			<nav class="breadcrumb">
				<a
					href="/files"
					hx-get="/files"
					hx-target="#browser-content"
					hx-swap="outerHTML"
					hx-push-url="/files"
				>My Files</a>
				<span class="breadcrumb-sep">/</span>
				<span class="breadcrumb-current">Search</span>
			</nav>
			<div style="display:flex;gap:8px;align-items:center;">
				@searchBox(q)
			</div>
		</div>
		<p class="section-heading">Results for “{ q }”</p>
		if len(folders) == 0 && len(files) == 0 {
			<div class="empty-state" style="padding:60px 20px;text-align:center;">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" style="width:40px;height:40px;opacity:.3;margin-bottom:12px;">
					<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"></path>
				</svg>
				<p style="font-size:14px;font-weight:500;color:var(--text);margin-bottom:6px;">No matches</p>
				<p style="font-size:12.5px;color:var(--text-muted);">Nothing named like “{ q }” was found.</p>
			</div>
		} else {
			if len(folders) > 0 {
				<p class="section-heading">Folders</p>
				<div class="file-grid">
					for _, folder := range folders {
						@FolderCard(folder)
					}
				</div>
			}
			if len(files) > 0 {
				<p class="section-heading">Files</p>
				<div class="file-grid">
					for _, file := range files {
						@FileCard(file,
							user.Role == "admin" || (user.Role == "editor" && file.UploaderID == user.ID),
							user.Role == "admin",
						)
					}
				</div>
			}
		}
	</div>
}

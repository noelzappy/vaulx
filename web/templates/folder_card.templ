package templates

import (
	"fmt"
	"github.com/brifafrica/vaulx/internal/viewmodel"
)

templ FolderCard(folder viewmodel.FolderView) {
	<div
		class="card"
		x-data={ "{ editing: false, draftName: '" + folder.Name + "' }" }
		title={ folder.Name }
	>
		<div class="card-actions" x-show="!editing" onclick="event.stopPropagation()">
			<button
				class="card-btn"
				x-on:click.stop="editing = true; $nextTick(() => $refs.renameInput.focus())"
			>Rename</button>
			<button
				class="card-btn card-btn-danger"
				hx-delete={ "/files/folders/" + folder.ID }
				hx-confirm={ "Delete \"" + folder.Name + "\"? All contents will be removed." }
				hx-target="closest .card"
				hx-swap="outerHTML swap:0.3s"
				onclick="event.stopPropagation()"
			>Delete</button>
		</div>
		<div
			class="card-icon card-folder-icon"
			x-show="!editing"
			hx-get={ "/files/" + folder.ID }
			hx-target="#browser-content"
			hx-swap="outerHTML"
			hx-push-url={ "/files/" + folder.ID }
			style="cursor:pointer;"
			onclick="event.stopPropagation()"
		>
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-8.69-6.44-2.12-2.12a1.5 1.5 0 0 0-1.061-.44H4.5A2.25 2.25 0 0 0 2.25 6v12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9a2.25 2.25 0 0 0-2.25-2.25h-5.379a1.5 1.5 0 0 1-1.06-.44Z"></path>
			</svg>
		</div>
		<div
			class="card-name"
			x-show="!editing"
			hx-get={ "/files/" + folder.ID }
			hx-target="#browser-content"
			hx-swap="outerHTML"
			hx-push-url={ "/files/" + folder.ID }
			style="cursor:pointer;"
			onclick="event.stopPropagation()"
		>{ folder.Name }</div>
		<div x-show="editing" onclick="event.stopPropagation()" style="padding-top:4px;">
			<form
				hx-patch={ "/files/folders/" + folder.ID }
				hx-target="closest .card"
				hx-swap="outerHTML"
				style="display:flex;gap:6px;align-items:center;"
				x-on:submit="editing = false"
			>
				<input
					class="input folder-rename-input"
					name="name"
					x-ref="renameInput"
					x-model="draftName"
					x-on:keydown.escape.prevent={ "editing = false; draftName = '" + folder.Name + "'" }
					placeholder="Folder name"
					required
					onclick="event.stopPropagation()"
				/>
				<button class="btn btn-primary" type="submit" style="padding:5px 10px;font-size:12px;" onclick="event.stopPropagation()">Save</button>
				<button
					class="btn btn-ghost"
					type="button"
					style="padding:5px 10px;font-size:12px;"
					x-on:click.stop={ "editing = false; draftName = '" + folder.Name + "'" }
				>Cancel</button>
			</form>
		</div>
		<div class="card-meta" x-show="!editing">
			<span>{ fmt.Sprintf("%d items", folder.ItemCount) }</span>
		</div>
	</div>
}

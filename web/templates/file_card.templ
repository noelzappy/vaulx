package templates

import "github.com/noelzappy/vaulx/internal/viewmodel"

templ FileCard(file viewmodel.FileView, canEdit bool, canHardDelete bool) {
	<div
		class="card"
		data-file-name={ file.Name }
		data-file-id={ file.ID }
		x-data="{ editing: false, menuOpen: false, menuX: 0, menuY: 0, moving: false, folders: [] }"
		:data-menu-open="menuOpen ? '1' : null"
		:data-editing="editing ? '1' : null"
		:class="{'card-selected': $store.selection.ids.includes($el.closest('.card').dataset.fileId)}"
		title={ file.Name }
		if canEdit {
			draggable="true"
			ondragstart="event.dataTransfer.setData('text/file-id', this.dataset.fileId); event.dataTransfer.effectAllowed = 'move'"
		}
		@contextmenu.prevent="menuX = ($event.clientX + 192 > window.innerWidth) ? $event.clientX - 192 : $event.clientX; menuY = ($event.clientY + 260 > window.innerHeight) ? $event.clientY - 260 : $event.clientY; menuOpen = true"
		@touchstart.passive="$el._lpt = setTimeout(() => {
			const r = $el.getBoundingClientRect();
			menuX = Math.min(r.left + 20, window.innerWidth - 196);
			menuY = Math.min(r.bottom + 4, window.innerHeight - 120);
			menuOpen = true;
			navigator.vibrate && navigator.vibrate(30)
		}, 500)"
		@touchend.passive="clearTimeout($el._lpt)"
		@touchmove.passive="clearTimeout($el._lpt)"
		@keydown.escape.window="menuOpen = false; moving = false"
		hx-get={ string(templ.SafeURL("/api/file/" + file.ID + "/preview")) }
		hx-target="#preview-panel"
		hx-swap="innerHTML"
		hx-trigger="click[!event.target.closest('[data-menu-open]') && !event.target.closest('[data-editing]') && !event.target.closest('.ctx-menu') && !event.target.closest('form') && !event.target.closest('input')]"
	>
		<!-- Selection overlay — covers the card while in select mode -->
		<div
			class="card-select-overlay"
			x-show="$store.selection.active"
			x-cloak
			@click.stop="null"
			@touchstart.stop
		>
			<div class="select-check" :class="{ 'selected': $store.selection.ids.includes($el.closest('.card').dataset.fileId) }">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" style="width:14px;height:14px;color:inherit;">
					<path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"></path>
				</svg>
			</div>
		</div>

		<!-- Floating context menu — position:fixed so it escapes card boundaries -->
		<div
			class="ctx-menu"
			x-show="menuOpen && !editing"
			x-cloak
			:style="`left:${menuX}px;top:${menuY}px`"
			@click.outside="menuOpen = false; moving = false"
		>
			<a
				class="ctx-item"
				href={ templ.SafeURL("/files/" + file.ID + "/download") }
				onclick="event.stopPropagation()"
			>
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
				Download
			</a>
			<button
				class="ctx-item"
				data-file-id={ file.ID }
				onclick="event.stopPropagation(); copyShareLink(this.dataset.fileId)"
				@close-menu.window="menuOpen = false"
			>
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244"/></svg>
				Copy link
			</button>
			if canEdit {
				<div class="ctx-sep"></div>
				<button
					class="ctx-item"
					x-on:click.stop="editing = true; menuOpen = false"
				>
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125"/></svg>
					Rename
				</button>
				<button
					class="ctx-item"
					x-on:click.stop="
						moving = !moving;
						if (moving && folders.length === 0) {
							fetch('/api/folders').then(r => r.json()).then(d => { folders = d })
						}
					"
				>
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-8.69-6.44-2.12-2.12a1.5 1.5 0 0 0-1.061-.44H4.5A2.25 2.25 0 0 0 2.25 6v12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9a2.25 2.25 0 0 0-2.25-2.25h-5.379a1.5 1.5 0 0 1-1.06-.44Z"/></svg>
					<span x-text="moving ? 'Pick a folder ▾' : 'Move to…'"></span>
				</button>
				<div class="ctx-submenu" x-show="moving" x-cloak onclick="event.stopPropagation()">
					<button
						class="ctx-folder-btn"
						x-on:click.stop="
							const fid = $el.closest('.card').dataset.fileId;
							htmx.ajax('PATCH', '/files/' + fid + '/folder', {
								source: $el,
								target: $el.closest('.card'),
								swap: 'outerHTML',
								values: { folderId: '' }
							});
							menuOpen = false; moving = false
						"
					>⬆ Root (no folder)</button>
					<template x-for="f in folders" :key="f.id">
						<button
							class="ctx-folder-btn"
							x-text="'📁 ' + f.name"
							x-on:click.stop="
								const fid = $el.closest('.card').dataset.fileId;
								fetch('/files/' + fid + '/folder', {
									method: 'PATCH',
									headers: { 'Content-Type': 'application/json' },
									body: JSON.stringify({ folderId: f.id })
								}).then(r => r.text()).then(html => {
									const card = $el.closest('.card');
									card.outerHTML = html;
									htmx.process(document.body);
								}).catch(() => {});
								menuOpen = false; moving = false
							"
						></button>
					</template>
				</div>
			}
			if canEdit || canHardDelete {
				<div class="ctx-sep"></div>
				if canEdit {
					<button
						class="ctx-item ctx-item-danger"
						hx-delete={ string(templ.SafeURL("/files/" + file.ID)) }
						hx-confirm={ "Delete \"" + file.Name + "\"? The file will be hidden but can be recovered by an admin." }
						hx-target="closest .card"
						hx-swap="outerHTML swap:0.3s"
						onclick="event.stopPropagation()"
					>
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/></svg>
						Delete
					</button>
				}
				if canHardDelete {
					<button
						class="ctx-item ctx-item-danger"
						hx-delete={ string(templ.SafeURL("/files/" + file.ID + "?permanent=true")) }
						hx-confirm={ "Permanently delete \"" + file.Name + "\"? This CANNOT be undone — the file will be removed from storage." }
						hx-target="closest .card"
						hx-swap="outerHTML swap:0.3s"
						onclick="event.stopPropagation()"
					>
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/></svg>
						Delete permanently
					</button>
				}
			}
		</div>

		<!-- Card content -->
		if file.ThumbURL != "" {
			<img
				class="card-thumb"
				x-show="!editing"
				src={ file.ThumbURL }
				alt={ file.Name }
				loading="lazy"
				draggable="false"
			/>
		} else {
			<div class="card-icon" x-show="!editing">
				@fileTypeIcon(file.MimeType)
			</div>
		}
		<div class="card-name" x-show="!editing">{ file.Name }</div>
		<div class="card-meta" x-show="!editing">
			<span>{ file.SizeHuman }</span>
			<span class="card-meta-sep">·</span>
			<span>{ file.UploaderName }</span>
			<span class="card-meta-sep">·</span>
			<span>{ file.RelativeDate }</span>
		</div>
		<div x-show="editing" onclick="event.stopPropagation()" style="padding-top:4px;">
			<form
				hx-patch={ string(templ.SafeURL("/files/" + file.ID + "/name")) }
				hx-target="closest .card"
				hx-swap="outerHTML"
				style="display:flex;flex-direction:column;gap:8px;"
			>
				<input
					class="input file-rename-input"
					name="name"
					x-bind:value="$el.closest('.card').dataset.fileName"
					x-on:keydown.escape.prevent="editing = false"
					placeholder="File name"
					required
					onclick="event.stopPropagation()"
				/>
				<div style="display:flex;gap:6px;">
					<button class="btn btn-primary" type="submit" style="padding:5px 10px;font-size:12px;" onclick="event.stopPropagation()">Save</button>
					<button
						class="btn btn-ghost"
						type="button"
						style="padding:5px 10px;font-size:12px;"
						x-on:click.stop="editing = false"
					>Cancel</button>
				</div>
			</form>
		</div>
	</div>
}

templ fileTypeIcon(mimeType string) {
	if len(mimeType) >= 5 && mimeType[:5] == "video" {
		<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" d="m15.75 10.5 4.72-4.72a.75.75 0 0 1 1.28.53v11.38a.75.75 0 0 1-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25h-9A2.25 2.25 0 0 0 2.25 7.5v9a2.25 2.25 0 0 0 2.25 2.25Z"></path>
		</svg>
	} else if len(mimeType) >= 5 && mimeType[:5] == "image" {
		<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"></path>
		</svg>
	} else {
		<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"></path>
		</svg>
	}
}
